{
  "name": "@rynl10n/web",
  "version": "0.1.0",
  "type": "module",
  "description": "앱 업데이트·심사 없이 번역을 배포하는 오픈소스 원격 로컬라이제이션 SDK (Web) — 빌드타임 번들 + 런타임 원격 오버레이 2계층",
  "license": "Apache-2.0",
  "author": "ChoiChiwon",
  "homepage": "https://github.com/devryner/RynL10n/blob/main/sdks/web/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devryner/RynL10n.git",
    "directory": "sdks/web"
  },
  "bugs": "https://github.com/devryner/RynL10n/issues",
  "keywords": [
    "localization",
    "i18n",
    "internationalization",
    "ota",
    "translations"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/sdks/web/src/index.d.ts",
      "default": "./dist/sdks/web/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:publish": "tsc -p tsconfig.publish.json",
    "prepack": "npm run build:publish"
  },
  "types": "./dist/sdks/web/src/index.d.ts"
}
